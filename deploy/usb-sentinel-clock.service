[Unit]
Description=USB Sentinel clock floor (no RTC, offline)
# Every boot would otherwise start at the same old time; see scripts/clock-floor.sh.
DefaultDependencies=no
After=local-fs.target
Before=time-set.target docker.service sysinit.target shutdown.target
Wants=time-set.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/usb-sentinel/scripts/clock-floor.sh restore
ExecStop=/opt/usb-sentinel/scripts/clock-floor.sh save

[Install]
WantedBy=sysinit.target
